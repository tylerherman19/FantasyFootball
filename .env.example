# Copy to .env.local and fill in. Never commit the filled version.

# --- The Odds API (Vegas lines) ---
# Free tier: 500 credits/month. Sign up at https://the-odds-api.com/#get-access
ODDS_API_KEY=

# --- Yahoo Fantasy API ---
# Create an app at https://developer.yahoo.com/apps/create/
# Permissions: Fantasy Sports -> Read
# Redirect URI must match exactly what you registered.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:3000/api/auth/yahoo/callback

# --- Supabase ---
# Project Settings -> API Keys (new-style sb_publishable_ / sb_secret_ keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Your leagues (comma-separated) ---
SLEEPER_LEAGUE_IDS=

# Optional. The web app asks for a Sleeper username and remembers it in a
# cookie, so anyone can use their own account without this being set. Setting it
# pins a default account for a single-user deployment; leave it blank otherwise.
SLEEPER_USERNAME=

# Optional. Overrides the season the app defaults to; otherwise it follows the
# calendar (the season just finished, until July).
SEASON=

YAHOO_LEAGUE_KEY=
