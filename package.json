{
  "name": "fantasy-football-edge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build --verbose && npm run typecheck --workspace=@ffe/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:sleeper": "tsx scripts/smoke-sleeper.ts",
    "lint": "npm run lint --workspace=@ffe/web",
    "format": "prettier --write .",
    "snapshot": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/snapshot.ts",
    "snapshot:ci": "tsx scripts/snapshot.ts",
    "build": "tsc --build",
    "dev": "npm run build && npm run dev --workspace=@ffe/web",
    "sync:canonical": "node --env-file=.env.local ./node_modules/.bin/tsx scripts/sync-canonical.ts",
    "setup:vercel": "bash scripts/setup-vercel-env.sh",
    "sanity:value": "tsx scripts/value-sanity.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "next": "16.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
